{
  "name": "x402-llm-gateway",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "Pay-per-request LLM gateway using x402 stablecoin micropayments on Stellar",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "nx run-many --target=build --all",
    "build:gateway": "nx build gateway",
    "build:dashboard": "nx build dashboard",
    "build:contracts": "bash scripts/build-contracts.sh",
    "dev:gateway": "nx serve gateway",
    "dev:dashboard": "nx dev dashboard",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "test": "nx run-many --target=test --all",
    "test:e2e": "nx run-many --target=test:e2e --all",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "nx run database:generate",
    "db:migrate": "nx run database:migrate",
    "db:push": "nx run database:push",
    "db:studio": "nx run database:studio",
    "docker:build": "docker compose -f infrastructure/docker/docker-compose.yml build",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "vercel:check": "bash scripts/vercel-deploy-check.sh",
    "clean": "nx reset && rm -rf node_modules dist .nx",
    "prepare": "husky"
  },
  "devDependencies": {
    "@nx/eslint": "^22.7.9",
    "@nx/eslint-plugin": "^22.7.9",
    "@nx/jest": "^22.7.9",
    "@nx/js": "^22.7.9",
    "@nx/next": "^22.7.9",
    "@nx/node": "^22.7.9",
    "@nx/workspace": "^22.7.9",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.3.0",
    "nx": "^22.7.9",
    "prettier": "^3.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@types/jsonwebtoken": "^9.0.10",
    "jsonwebtoken": "^9.0.3",
    "tslib": "^2.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  }
}
